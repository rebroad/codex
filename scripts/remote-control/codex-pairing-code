#!/usr/bin/env sh
set -eu

home_dir="${HOME:?HOME must be set}"
codex_home="${CODEX_HOME:-$home_dir/.codex}"
codex_bin="${CODEX_BIN:-}"
timeout_seconds="${CODEX_REMOTE_PAIR_TIMEOUT:-20}"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
control_socket="$codex_home/app-server-control/app-server-control.sock"
lock_dir="$codex_home/app-server-control/pairing-code.lock"
start_option=""
profile_name=""

usage() {
    printf '%s\n' 'Usage: codex-pairing-code [-p|--profile PROFILE] [--debug-log]'
}

if [ -z "$codex_bin" ]; then
    codex_bin=$(command -v codex) || {
        printf '%s\n' 'Codex Remote: codex was not found; set CODEX_BIN to its path.' >&2
        exit 1
    }
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        --debug-log)
            start_option="--debug-log"
            ;;
        -p|--profile)
            [ "$#" -ge 2 ] || {
                usage >&2
                exit 2
            }
            profile_name="$2"
            shift
            ;;
        --profile=*)
            profile_name="${1#--profile=}"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done

case "$profile_name" in
    ""|*[!A-Za-z0-9._-]*)
        [ -z "$profile_name" ] || printf 'Codex Remote: invalid profile name: %s\n' "$profile_name" >&2
        [ -z "$profile_name" ] || exit 2
        ;;
esac

if [ -n "$profile_name" ]; then
    control_socket="$codex_home/app-server-control/$profile_name/app-server-control.sock"
    lock_dir="$codex_home/app-server-control/$profile_name/pairing-code.lock"
    export CODEX_PROFILE="$profile_name"
fi

mkdir -p "$(dirname "$lock_dir")"
if ! mkdir "$lock_dir" 2>/dev/null; then
    printf '%s\n' 'Codex Remote: another pairing request is already running.' >&2
    exit 1
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM

if [ ! -S "$control_socket" ] || [ -n "$start_option" ]; then
    remote_start="$script_dir/codex-remote-start"
    if [ ! -x "$remote_start" ]; then
        printf 'Codex Remote: companion script is not executable: %s\n' "$remote_start" >&2
        exit 1
    fi
    if [ -n "$start_option" ]; then
        if [ -n "$profile_name" ]; then
            "$remote_start" --profile "$profile_name" "$start_option"
        else
            "$remote_start" "$start_option"
        fi
    else
        if [ -n "$profile_name" ]; then
            "$remote_start" --profile "$profile_name"
        else
            "$remote_start"
        fi
    fi
fi

pairing_json=""
pairing_status=1
attempt=1
while [ "$attempt" -le 4 ]; do
    pairing_status=0
    pairing_json="$(timeout "$timeout_seconds" "$codex_bin" remote-control pair --json 2>&1)" || pairing_status=$?
    [ "$pairing_status" -eq 0 ] && break

    case "$pairing_json" in
        *"timed out waiting for remoteControl/pairing/start response"*|*"deadline has elapsed"*)
            sleep 2
            ;;
        *)
            break
            ;;
    esac
    attempt=$((attempt + 1))
done

if [ "$pairing_status" -ne 0 ]; then
    printf 'Codex Remote: could not create a pairing code (%s).\n' "$pairing_json" >&2
    exit "$pairing_status"
fi

manual_code="$(printf '%s' "$pairing_json" | sed -n \
    's/.*"manualPairingCode"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p')"
if [ -z "$manual_code" ]; then
    printf '%s\n' 'Codex Remote: pairing response did not contain a manual code.' >&2
    exit 1
fi

printf '\nCodex Remote pairing code: %s\n' "$manual_code"
printf '%s\n\n' 'ChatGPT/Codex app → Remote → Add or pair device'
